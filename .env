# Gemini API Configuration
# Reemplaza 'YOUR_GEMINI_API_KEY_HERE' con tu clave API real de Google Gemini

# ObraSeco BuilderBot Environment Configuration

# Google Gemini Configuration (Múltiples API Keys para Load Balancing)
GEMINI_API_KEY=1
GEMINI_API_KEY_2=2
GEMINI_API_KEY_3=3
GEMINI_API_KEY_4=4
GEMINI_API_KEY_5=5
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.1

# Rate Limiting - Optimizado para cuenta paga (360 RPM por key)
MAX_REQUESTS_PER_MINUTE=300
GEMINI_TIMEOUT=15000
GEMINI_MAX_RETRIES=2

# OpenAI Configuration (solo para transcripción si es necesario)
OPENAI_API_KEY=1234
OPENAI_TRANSCRIPTION_MODEL=whisper-1
